            "type": "text",
            "text": "interface SyncBatch {\n  deviceId: string;\n  ops: Array<{ id: string; noteId: string; kind: \"upsert\" | \"delete\"; at: number }>;\n}\n\nasync function flush(outbox: Outbox): Promise<void> {\n  const batch = await outbox.take(50);\n  if (batch.ops.length === 0) return;\n  await fetch(\"/sync\", { method: \"POST\", body: JSON.stringify(batch) });\n}"
