{
  // Code that runs in the browser: src/web and src/shared, with DOM types and no Node types.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.vue", "src/shared/**/*.ts"]
}
