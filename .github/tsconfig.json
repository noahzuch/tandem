{
  // The CI scripts in .github/. Node runs them directly; they belong to the workflows, not to the product.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.ci.tsbuildinfo",
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": ["*.ts", "../vitest.config.ts"]
}
